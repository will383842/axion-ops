{
  "name": "axion-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Socle générique de pilotage — autorise, journalise, limite, route. Aucun métier.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.4",
  "bin": {
    "axion-ops": "./dist/ops/index.js"
  },
  "scripts": {
    "start": "node dist/ops/index.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy && prisma db execute --schema prisma/schema.prisma --file prisma/sql/0001-ops-audit-append-only.sql",
    "ops:vault:init": "tsx ops/vault-init.ts",
    "zoho:bootstrap": "tsx adapters/zoho-mail/bootstrap/index.ts --amorcage-explicite",
    "zoho:bootstrap:dist": "node dist/adapters/zoho-mail/bootstrap/index.js --amorcage-explicite",
    "ops:vault:init:dist": "node dist/ops/vault-init.js"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "prisma": "5.22.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
